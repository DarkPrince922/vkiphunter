#!/usr/bin/env bash
# Управление ботом как фоновой службой — там, где нет systemd
# (Termux/proot, обычный shell). Бот переживает закрытие терминала,
# Ctrl+C и собственные падения.
#
#   ./scripts/vkiphunterctl start | stop | restart | status | logs
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATA="$ROOT/data"
LOG="$DATA/bot.log"
SUP_PID="$DATA/supervisor.pid"
BOT_PID="$DATA/bot.pid"
FLAG="$DATA/run.flag"
PY="$ROOT/.venv/bin/python"

# .env и data/ адресуются относительно корня проекта, а не текущей папки.
cd "$ROOT" || exit 1

MAX_LOG_BYTES=$((5 * 1024 * 1024))
RESTART_DELAY=5
FAST_FAIL_SECONDS=10
FAST_FAIL_LIMIT=5

mkdir -p "$DATA"

stamp() { date '+%Y-%m-%d %H:%M:%S'; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
pid_of() { [ -f "$1" ] && cat "$1" 2>/dev/null; }

rotate_log() {
    [ -f "$LOG" ] || return 0
    local size
    size=$(wc -c <"$LOG" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_LOG_BYTES" ]; then
        mv "$LOG" "$LOG.1"
    fi
}

# Внутренний режим: следит за ботом и поднимает его после падений.
supervise() {
    local fails=0
    while [ -f "$FLAG" ]; do
        rotate_log
        local started
        started=$(date +%s)

        "$PY" -m vkiphunter >>"$LOG" 2>&1 &
        local child=$!
        echo "$child" >"$BOT_PID"
        wait "$child"
        local code=$?

        [ -f "$FLAG" ] || break

        local ran=$(( $(date +%s) - started ))
        if [ "$ran" -lt "$FAST_FAIL_SECONDS" ]; then
            fails=$((fails + 1))
        else
            fails=0
        fi

        if [ "$fails" -ge "$FAST_FAIL_LIMIT" ]; then
            echo "$(stamp) супервизор: бот падает сразу после запуска ${fails} раз подряд." >>"$LOG"
            echo "$(stamp) супервизор: сдаюсь. Причина — выше в этом логе; после починки: $0 start" >>"$LOG"
            rm -f "$FLAG"
            break
        fi

        echo "$(stamp) супервизор: бот вышел с кодом ${code}, перезапуск через ${RESTART_DELAY} с" >>"$LOG"
        sleep "$RESTART_DELAY"
    done
    rm -f "$BOT_PID" "$SUP_PID"
}

start() {
    local pid
    pid=$(pid_of "$SUP_PID")
    if alive "$pid"; then
        echo "Уже запущен (супервизор $pid)."
        return 0
    fi

    if [ ! -x "$PY" ]; then
        echo "Не найден $PY — соберите окружение:" >&2
        echo "  python3 -m venv $ROOT/.venv && $ROOT/.venv/bin/pip install -r $ROOT/requirements.txt" >&2
        return 1
    fi

    touch "$FLAG"
    if command -v setsid >/dev/null 2>&1; then
        setsid nohup "$0" __supervise >>"$LOG" 2>&1 </dev/null &
    else
        nohup "$0" __supervise >>"$LOG" 2>&1 </dev/null &
    fi
    echo $! >"$SUP_PID"
    sleep 1

    if alive "$(pid_of "$SUP_PID")"; then
        echo "Запущен. Лог: $LOG"
        echo "Посмотреть: $0 logs"
    else
        echo "Не удалось запустить, смотрите $LOG" >&2
        return 1
    fi
}

stop() {
    rm -f "$FLAG"
    local sup bot
    sup=$(pid_of "$SUP_PID")
    bot=$(pid_of "$BOT_PID")

    alive "$bot" && kill "$bot" 2>/dev/null
    alive "$sup" && kill "$sup" 2>/dev/null

    for _ in $(seq 1 20); do
        alive "$bot" || alive "$sup" || break
        sleep 0.5
    done

    alive "$bot" && kill -9 "$bot" 2>/dev/null
    alive "$sup" && kill -9 "$sup" 2>/dev/null
    rm -f "$SUP_PID" "$BOT_PID"
    echo "Остановлен."
}

status() {
    local sup bot
    sup=$(pid_of "$SUP_PID")
    bot=$(pid_of "$BOT_PID")
    if alive "$sup"; then
        echo "Работает: супервизор $sup, бот ${bot:-—}"
    else
        echo "Не запущен."
    fi
    if [ -f "$LOG" ]; then
        echo
        echo "— последние строки лога —"
        tail -n 12 "$LOG"
    fi
}

case "${1:-}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    logs)    touch "$LOG"; tail -n 50 -f "$LOG" ;;
    __supervise) supervise ;;
    *)
        echo "Использование: $0 {start|stop|restart|status|logs}"
        exit 1
        ;;
esac
