# Автозапуск бота на сервере.
#   cp scripts/vkiphunter.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now vkiphunter
#
# Токен и доступы к облаку бот хранит в data/credentials.json, поэтому
# .env не обязателен — файл подключается, только если он есть.
[Unit]
Description=VK IP Hunter Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Раскомментируйте, если бот установлен под отдельным пользователем
# (см. INSTALL.md) — каталог /opt/vkiphunter должен принадлежать ему.
#User=vkiphunter
#Group=vkiphunter
WorkingDirectory=/opt/vkiphunter
EnvironmentFile=-/opt/vkiphunter/.env
ExecStart=/opt/vkiphunter/.venv/bin/python -m vkiphunter
Restart=always
RestartSec=10
# В data/credentials.json лежит пароль от облака — новые файлы создаём с 0600.
UMask=0077

[Install]
WantedBy=multi-user.target
