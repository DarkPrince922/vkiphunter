# Ничего из этого не обязательно: токен и доступы к облаку бот спросит сам
# при первом запуске и сохранит в data/credentials.json с правами 0600.
# Файл нужен, только если удобнее задать значения заранее.
# Заданное в боте имеет приоритет над этими переменными.

# ── Telegram ─────────────────────────────────────────────────────────────
# Токен от @BotFather. Если не задать — бот спросит его в терминале.
BOT_TOKEN=
# Кто может управлять ботом. Если оставить пустым, владельцем станет
# первый, кто отправит /start, — его ID сохранится навсегда.
ALLOWED_USER_IDS=

# ── Файлы и логи ─────────────────────────────────────────────────────────
STATE_FILE=data/state.json
CREDENTIALS_FILE=data/credentials.json
LOG_LEVEL=INFO

# SIMULATE=1 — прогон без облака: порты не создаются, адреса генерируются.
SIMULATE=0

# ── VK Cloud (OpenStack) ─────────────────────────────────────────────────
# Имена совпадают с OpenRC-файлом проекта: если сделать
#   set -a && source /root/mcsXXXXXXXXX-openrc.sh && set +a
# перед запуском, этот блок не нужен. Либо просто пришлите содержимое
# openrc-файла боту командой /connect.
OS_AUTH_URL=
OS_REGION_NAME=RegionOne
OS_INTERFACE=public
OS_PROJECT_ID=
OS_USERNAME=
OS_PASSWORD=
OS_USER_DOMAIN_NAME=users

# Вместо логина и пароля — application credential:
#   openstack application credential create vkiphunter
# OS_APPLICATION_CREDENTIAL_ID=
# OS_APPLICATION_CREDENTIAL_SECRET=
