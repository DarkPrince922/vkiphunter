# ── Telegram ─────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456:AAAA-BBBB
# Кто может управлять ботом. Свой ID узнать: /whoami (или @userinfobot).
# Несколько — через запятую. Пустое значение = бот никого не пустит.
ALLOWED_USER_IDS=123456789

# ── Режим ────────────────────────────────────────────────────────────────
# SIMULATE=1 — прогон без облака: порты не создаются, адреса генерируются.
# Удобно проверить бота до подключения к VK Cloud.
SIMULATE=0
LOG_LEVEL=INFO
STATE_FILE=data/state.json

# ── VK Cloud (OpenStack) ─────────────────────────────────────────────────
# Имена совпадают с OpenRC-файлом проекта: если сделать
#   set -a && source /root/mcsXXXXXXXXX-openrc.sh && set +a
# перед запуском, этот блок в .env не нужен.
OS_AUTH_URL=https://infra.mail.ru:35357/v3/
OS_REGION_NAME=RegionOne
OS_INTERFACE=public
OS_IDENTITY_API_VERSION=3

OS_PROJECT_ID=
OS_PROJECT_NAME=
OS_USERNAME=
OS_PASSWORD=
OS_USER_DOMAIN_NAME=users

# Вместо логина и пароля лучше application credential — он не протухает
# вместе с паролем аккаунта и ограничен по правам:
#   openstack application credential create vkiphunter
# OS_APPLICATION_CREDENTIAL_ID=
# OS_APPLICATION_CREDENTIAL_SECRET=
